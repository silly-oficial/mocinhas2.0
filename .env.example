# Render Free: run supabase/mocinhas_persistence.sql, then configure these server variables.
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for a NEW/EMPTY remote state. Existing admins are NEVER reset.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Long random secret, stable between deployments. Keep an existing production value.
JWT_SECRET=
PORT=3000

# Optional public browser configuration; never put a service role/secret key here.
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local JSON backend instead of cloud (requires actual persistent disk in production).
# STORAGE_BACKEND=local
# DATA_DIR=/var/data/mocinhas
# Optional development demo only, NEVER enabled in production:
# ALLOW_DEMO_SEED=1

APP_URL=
GEMINI_API_KEY=
# Set only to trusted proxy addresses/subnets supplied by your hosting provider.
# TRUST_PROXY=loopback
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_WEBHOOK_SECRET=
SYNCPAY_WEBHOOK_URL=
